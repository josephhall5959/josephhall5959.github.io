	annote = {Publisher: The University of Chicago Press},
	file = {Full Text PDF:/Users/jhall390/Zotero/storage/YSNH2FL5/DeMarzo et al. - 2023 - Sovereign Debt Ratchets and Welfare Destruction.pdf:application/pdf},
}

@article{ganong_liquidity_2020,
	title = {Liquidity versus {Wealth} in {Household} {Debt} {Obligations}: {Evidence} from {Housing} {Policy} in the {Great} {Recession}},
